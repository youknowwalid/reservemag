{
  "name": "reservemag",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx --env-file-if-exists=.env server.ts",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "npm run clean && tsc && vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs --define:process.env.NODE_ENV='\"production\"' && esbuild social-ssr.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/social-ssr.cjs --define:process.env.NODE_ENV='\"production\"'",
    "preview": "vite preview",
    "ai:health": "tsx --env-file-if-exists=.env scripts/test-ai-provider.ts",
    "test:source-retrieval": "tsx --env-file-if-exists=.env scripts/test-source-retrieval.ts",
    "test:editorial-cost-safety": "tsx scripts/test-editorial-cost-safety.ts",
    "test:r2-banner-upload": "tsx scripts/test-r2-banner-upload.ts",
    "test:news-banner-template": "tsx scripts/test-news-banner-template.ts",
    "test:contributor-signup": "tsx scripts/test-contributor-signup.ts",
    "test:contributor-sign-out": "tsx scripts/test-contributor-sign-out.ts",
    "test:editorial-board": "tsx scripts/test-editorial-board.ts",
    "test:server-routing": "tsx --env-file-if-exists=.env scripts/test-server-routing.ts",
    "test:hero-clearance": "tsx scripts/test-hero-header-clearance.ts",
    "test:listing-pages": "tsx scripts/test-listing-pages.ts",
    "test:contributor-otp-verify": "tsx scripts/test-contributor-otp-verify.ts",
    "test:profile-completion": "tsx scripts/test-profile-completion.ts",
    "test:contributor-admin-actions": "tsx scripts/test-contributor-admin-actions.ts",
    "test:submission-review": "tsx scripts/test-submission-review.ts",
    "test:editorial-auth": "tsx --env-file-if-exists=.env scripts/test-editorial-auth-propagation.ts",
    "test:editorial-provider": "tsx scripts/test-editorial-provider-responses.ts",
    "test:subject-segmentation-fallback": "tsx scripts/test-subject-segmentation-fallback.ts",
    "test:editorial-qa-originality": "tsx scripts/test-editorial-qa-originality.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1115.0",
    "@google/genai": "latest",
    "@mediapipe/tasks-vision": "^1.0.1",
    "@supabase/supabase-js": "^2.45.0",
    "cheerio": "^1.2.0",
    "cors": "^2.8.5",
    "express": "^4.21.0",
    "lucide-react": "^0.400.0",
    "motion": "12.23.12",
    "papaparse": "^5.4.1",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-helmet-async": "^2.0.0",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^6.0.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.14.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vercel/node": "^5.3.21",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.19",
    "esbuild": "^0.23.0",
    "postcss": "^8.4.38",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.20.3",
    "typescript": "^5.4.5",
    "vite": "^5.3.1"
  },
  "overrides": {
    "react": "18.3.1",
    "react-dom": "18.3.1"
  }
}
