# Server-only secrets

# Reserve Editorial Engine AI provider (Tabitoken gateway -- an
# OpenAI-compatible Chat Completions API). NEVER hardcode the API key
# anywhere in source, a React component, or a prompt -- set it here locally
# and in your production environment settings only. Read exclusively by
# src/services/ai/tabitokenProvider.ts.
TABITOKEN_API_KEY=
TABITOKEN_BASE_URL=https://tabitoken.com/v1
TABITOKEN_MODEL=claude-opus-4-8-thinking

# Per-attempt timeout for one Reserve Editorial Intelligence Engine
# generation call (milliseconds). The editorial layer always makes at
# most ONE Tabitoken request per generation (retries: 0 -- see
# editorialGenerationService.ts), so raising this only affects how long a
# single attempt is allowed to run before it's treated as a hard failure;
# it does not multiply cost. Defaults to 240000 (4 minutes) if unset.
EDITORIAL_GENERATION_TIMEOUT_MS=240000

# Legacy/deprecated -- the original Gemini integration. No longer used by
# the editorial engine (superseded by Tabitoken above; see
# src/services/ai/legacy/geminiProvider.deprecated.ts). Left here only so a
# rollback doesn't require reconstructing the variable names. Safe to leave
# blank or delete.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# Supabase (client + server)
# These are read both by Vite for the browser bundle (as import.meta.env.VITE_*)
# and by the Node server (server.ts / social-ssr.ts, via process.env.VITE_*).
# The anon/publishable key is sufficient everywhere -- no service-role key is
# needed, since RLS policies already grant the access these code paths need.
VITE_SUPABASE_URL=https://joqcgjpcvatnmjbzvhde.supabase.co
VITE_SUPABASE_ANON_KEY=

# Canonical public site URL
SITE_URL=https://thereservemag.com

# Optional local server settings
PORT=3000
DISABLE_HMR=false
