# Server-only secrets

# Reserve Editorial Engine AI provider (Tabitoken gateway -- an
# OpenAI-compatible Chat Completions API). NEVER hardcode the API key
# anywhere in source, a React component, or a prompt -- set it here locally
# and in your production environment settings only. Read exclusively by
# src/services/ai/tabitokenProvider.ts.
TABITOKEN_API_KEY=
TABITOKEN_BASE_URL=https://tabitoken.com/v1
TABITOKEN_MODEL=claude-opus-4-8-thinking

# Per-attempt timeout for one Reserve Editorial Intelligence Engine
# generation call (milliseconds). The editorial layer always makes at
# most ONE Tabitoken request per generation (retries: 0 -- see
# editorialGenerationService.ts), so raising this only affects how long a
# single attempt is allowed to run before it's treated as a hard failure;
# it does not multiply cost. Defaults to 240000 (4 minutes) if unset.
EDITORIAL_GENERATION_TIMEOUT_MS=240000

# Legacy/deprecated -- the original Gemini integration. No longer used by
# the editorial engine (superseded by Tabitoken above; see
# src/services/ai/legacy/geminiProvider.deprecated.ts). Left here only so a
# rollback doesn't require reconstructing the variable names. Safe to leave
# blank or delete.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# Supabase (client + server)
# These are read both by Vite for the browser bundle (as import.meta.env.VITE_*)
# and by the Node server (server.ts / social-ssr.ts, via process.env.VITE_*).
# The anon/publishable key is sufficient everywhere -- no service-role key is
# needed, since RLS policies already grant the access these code paths need.
VITE_SUPABASE_URL=https://joqcgjpcvatnmjbzvhde.supabase.co
VITE_SUPABASE_ANON_KEY=

# Canonical public site URL
SITE_URL=https://thereservemag.com

# Instagram Graph API (Content Publishing) -- server-only, read exclusively
# by src/services/instagramGraphService.ts via server.ts's
# POST /api/admin/instagram-publish route. NEVER exposed to the browser
# bundle (no VITE_ prefix). Powers the "Publish to Instagram" button in
# InstagramBannerPanel.tsx, which posts an already-uploaded banner (a
# public Supabase Storage URL) straight to the connected IG account.
#
# This app authenticates via Instagram API with Instagram Login (logging
# into Instagram directly, not through a linked Facebook Page), which is
# why instagramGraphService.ts calls graph.instagram.com rather than
# graph.facebook.com -- using the wrong host is the #1 way this silently
# fails ("Cannot parse access token").
#
# IG_ACCESS_TOKEN: an Instagram User Access Token from that flow (starts
# with "IGAA"), carrying instagram_business_basic +
# instagram_business_content_publish. Short-lived by default -- exchange
# for a long-lived token (~60 days) via
# GET graph.instagram.com/access_token?grant_type=ig_exchange_token
# and refresh it before expiry via
# GET graph.instagram.com/refresh_access_token?grant_type=ig_refresh_token.
IG_ACCESS_TOKEN=
# IG_BUSINESS_ACCOUNT_ID: the numeric Instagram user id this token
# authenticates as. Verify any token/id pair with a harmless read call:
# GET graph.instagram.com/v26.0/{IG_BUSINESS_ACCOUNT_ID}?fields=username&access_token=...
IG_BUSINESS_ACCOUNT_ID=
# Graph API version to call. Bump when Meta deprecates the current one --
# see devtools_api_usage's `deprecations` action for advance notice.
IG_GRAPH_API_VERSION=v26.0

# Optional local server settings
PORT=3000
DISABLE_HMR=false
